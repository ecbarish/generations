config_version=5
[application]
config/name="Wildbond Sprite Workbench"
run/main_scene="res://workbench.tscn"
config/features=PackedStringArray("4.7")
[display]
window/size/viewport_width=1200
window/size/viewport_height=820
window/size/window_width_override=1200
window/size/window_height_override=820
window/size/min_width=800
window/size/min_height=600
window/stretch/mode="disabled"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055,0.075,0.105,1)
