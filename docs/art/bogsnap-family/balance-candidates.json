  "ability_contracts": {
    "overgrow": {
      "effect": "multiply corresponding attacking stat for grass moves by1.5 when hp*3<=max_hp"
    },
    "torrent": {
      "effect": "multiply corresponding attacking stat for water moves by1.5 when hp*3<=max_hp"
    },
    "blaze": {
      "effect": "multiply corresponding attacking stat for fire moves by1.5 when hp*3<=max_hp"
    },
    "shell-armor": {
      "effect": "prevent critical hits; does not reduce ordinary damage",
      "requires": [
        "critical-hit engine"
      ]
    },
    "thick-fat": {
      "effect": "multiply incoming fire/ice move corresponding attacking stat by0.5",
      "type_effectiveness_unchanged": true
    }
  },
